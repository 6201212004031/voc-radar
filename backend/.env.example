# ============================================================
# VOC Radar 环境变量模板
# 使用方法：复制为 .env 并填入实际值
#   cp .env.example .env
# ============================================================

# ---------- Model Router 配置 ----------
# 阿里云百炼个人 API Key（开发期）/ 比赛 Key（初赛后切换）
MODEL_ROUTER_API_KEY=sk-your-personal-bailian-key

# Model Router Base URL
# 个人开发期：https://dashscope.aliyuncs.com/compatible-mode/v1
# 比赛阶段： https://model-router.edu-aliyun.com/v1
MODEL_ROUTER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 模型名称（与百炼平台对应，按需调整） ----------
MODEL_EMBEDDING=text-embedding-v4
MODEL_LLM=qwen3.7-max
MODEL_R1=deepseek-r1
MODEL_VISION=qwen3-vl-plus
MODEL_FLASH=qwen3.5-flash

# ---------- 数据库 ----------
# SQLite 文件路径（相对 backend/ 目录）
DATABASE_URL=sqlite:///./data/voc_radar.db

# ---------- 聚类配置 ----------
CLUSTER_K_MIN=8
CLUSTER_K_MAX=15
CLUSTER_BATCH_SIZE=100
# 聚类代表性评论每簇取 Top N
CLUSTER_REPRESENTATIVE_TOP_N=10
# silhouette 低于此阈值降级到默认 k=10 并告警
CLUSTER_SILHOUETTE_FLOOR=0.2

# ---------- Pipeline 配置 ----------
# Top N 进入 R1 归因
TOP_N_FOR_R1=5
# Top N 候选（按影响面取前 8 再分级筛选）
TOP_N_CANDIDATES=8
# R1 调用最大重试次数
R1_MAX_RETRIES=3
# LLM 调用超时（秒）
LLM_TIMEOUT_SECONDS=60
# 共性弱点判定：竞品占比阈值
COMMON_WEAKNESS_RATIO_THRESHOLD=0.15
COMMON_WEAKNESS_COMPETITOR_MIN=2

# ---------- Embedding 配置 ----------
# 批量调用每批最大条数（text-embedding-v4 单次上限为 10，超过会报
# InvalidParameter: batch size is invalid——必须 ≤10，勿改回 100）
EMBEDDING_BATCH_SIZE=10
# 是否启用 embedding 缓存（基于内容 hash）
EMBEDDING_CACHE_ENABLED=true

# ---------- 报告输出目录 ----------
REPORT_OUTPUT_DIR=./data/reports

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---------- 公开只读演示部署 ----------
# true 时拒绝所有非 GET 请求（仅开放浏览类接口），用于公开只读体验部署：
# 评委可交互浏览已有分析结果，但不暴露「新建项目/触发分析」入口，不消耗模型额度
READ_ONLY=false
